{
  "name": "visa-helper-mcp-app",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "decision:graph": "node scripts/decision-artifacts.mjs",
    "decision:replay": "node scripts/decision-artifacts.mjs",
    "check:release": "node scripts/check-release.mjs",
    "task:graph": "node scripts/task-artifacts.mjs",
    "task:replay": "node scripts/task-artifacts.mjs replay",
    "test:flows": "node scripts/test-flows.mjs",
    "test:flows:update-contract": "node scripts/test-flows.mjs --update-contract",
    "task:graph:check": "node scripts/task-artifacts.mjs --check",
    "test:regression": "npm test && npm run test:flows && npm run task:graph:check && npm run decision:graph:check",
    "decision:graph:check": "node scripts/check-decision-graphs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@modelcontextprotocol/server": "^2.3.1",
    "xstate": "5.33.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dagrejs/dagre": "1.1.8",
    "json-logic-js": "2.0.5"
  }
}
