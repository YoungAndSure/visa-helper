[Unit]
Description=Visa Helper MCP App (local staging)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/visa-helper-mcp
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=18081
ExecStart=/home/ubuntu/visa-helper-mcp/runtime/node /home/ubuntu/visa-helper-mcp/src/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/visa-helper-mcp/data

[Install]
WantedBy=multi-user.target
