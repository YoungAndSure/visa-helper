VISA_HELPER_DATA_DIR=/home/ubuntu/visa-helper-mcp/data
VISA_HELPER_PORT=18081
# Optional independent read-only guide pages; leave the base URL empty to disable.
VISA_HELPER_GUIDE_BASE_URL=
VISA_HELPER_GUIDE_BIND=127.0.0.1
VISA_HELPER_GUIDE_PORT=18080
# Enable only for temporary IP:port tests; use HTTPS for deployment with a domain.
VISA_HELPER_GUIDE_ALLOW_HTTP=0
