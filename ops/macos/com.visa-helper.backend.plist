    <string>300</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>/Users/yangshuo/Code/visa-helper/backend/logs/backend.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yangshuo/Code/visa-helper/backend/logs/backend.log</string>
